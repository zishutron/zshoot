{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "README.txt", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {"source": "/admin/**", "headers": [{"key": "X-Robots-Tag", "value": "noindex"}]},
      {"source": "**/*.@(webp|jpg|png|mp3)", "headers": [{"key": "Cache-Control", "value": "public,max-age=604800"}]}
    ]
  },
  "firestore": {"rules": "firestore.rules"}
}
